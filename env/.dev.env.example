# MT5 Factory 环境配置模板 — 复制为 .dev.env 填真值(真值只存本地, 不进 git)
# 一份配置两边共用: Linux 用 make(--env-file 指向它), Windows 整仓 clone 后 bridge/runner 直接读。
# 必改: Linux 填 POSTGRES_PASSWORD; Windows 填 SERVER_API_URL(跑 runner 还要 MT5_LOGIN 三件套)。

# ===================== Linux (docker compose) =====================
ENV_NAME=dev
LOG_LEVEL=INFO
API_PORT=8010                # api 容器绑到宿主机的端口
WEB_PORT=8000                # web 容器绑到宿主机的端口
DOCKER_COMPOSE_HOST=127.0.0.1  # 本机(Linux VM)的 IP — 纯备注, 无代码读取:
                             #   浏览器开 它:WEB_PORT 看页面; Windows 那边填进 SERVER_API_URL
DB_HOST=postgres             # 本地=docker 服务名; 换 RDS 填域名
DB_PORT=5432
POSTGRES_USER=mt5user
POSTGRES_PASSWORD=change_me  # 必改
POSTGRES_DB=mt5factory
SECRET_KEY=                  # Flask 会话签名密钥: session 存在浏览器 cookie 里(现只存
                             # 右上角切换的 dev_user_id), 靠它签名防篡改
                             # 【TODO 做安全加固时一并处理】现在防护价值有限 —— api 层无条件信
                             # X-User-Id 头, 冒充 owner 直接打 api 更省事, 不必伪造 cookie。
                             # 且兜底值写在两处且不一致(compose=mt5web / app.py=mt5web-dev),
                             # 违反"兜底默认值不落代码"。届时要么统一要么整条删干净

# ===================== Windows (worker) =====================
SERVER_API_URL=                # 【必填】Linux api 的完整地址, 每台 worker 按自己的网络填:
                               #   内网  http://192.168.4.130:8010
                               #   公网  https://api.demo.com/api
                               # bridge/runner 全靠它找 api; 空或不含协议 = 不注册并明确报错
WORKER_KEY=                    # 本机钥匙: 管理页「用户管理」签发, 一机一把;
                               # announce 带它 = 机器自动归钥主; 空 = 匿名注册(v5.6 起强制)
MT5_PORT=8020                  # 本机 bridge 端口 (Windows 唯一对外端口; runner 也用它找 bridge)
RUN_STATUS=DEMO                # 仅兜底: 角色真实来源是 web 指派的 mt5_hosts.runner
                               # (runner 按计算机名查 /hosts 读它); 只有 api 请求失败时才回落到这个值
VOLUME=0.01                    # 仅兜底: 手数优先级 = 每策略 strategies.volume
                               # > 全局默认 config.volume_default(api 随策略下发)
                               # > 本行; 只有 api 没给值时才用到
MT5_PATH=                      # terminal64.exe 路径, setup.ps1 探测后自动写入, 无需手填
MT5_LOGIN=                     # MT5 账号三件套: runner 开机自动登录终端用
MT5_PASSWORD=                  #   (不填则用终端里已保存的账号; 见 env/account.txt)
MT5_SERVER=
